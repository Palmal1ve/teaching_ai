# Copy to .env and fill in every empty value. Never commit .env.
# Generate secrets with: openssl rand -hex 32

# ── Secrets (required) ───────────────────────────────────────────────
POSTGRES_PASSWORD=
MINIO_ROOT_USER=course
MINIO_ROOT_PASSWORD=
# At least 32 characters.
JWT_SECRET=

# ── First admin account (required) ───────────────────────────────────
ADMIN_EMAIL=admin@example.edu
ADMIN_PASSWORD=

# ── LLM (required) ───────────────────────────────────────────────────
# Any OpenAI-compatible /v1/chat/completions endpoint with json_schema output.
#   Local vLLM / SGLang: http://host.docker.internal:8000/v1
#   Hosted provider:     https://api.your-provider.com/v1
LLM_BASE_URL=
LLM_MODEL=
# Leave empty if your endpoint needs no key.
LLM_API_KEY=

# ── Whisper weights (required) ───────────────────────────────────────
# Download once: uvx --from huggingface_hub hf download Systran/faster-whisper-small
# Mounted read-only; SNAPSHOT is the folder name under snapshots/.
WHISPER_CACHE_DIR=/Users/YOU/.cache/huggingface/hub/models--Systran--faster-whisper-small
WHISPER_SNAPSHOT=536b0662742c02347bc0e980a01041f333bce120

# ── Optional ─────────────────────────────────────────────────────────
WEB_PORT=8080
# 1 adds one-click "As student" / "As admin" buttons to the login page. Keep 0 on a shared network.
DEMO_LOGIN=0

# Package and model mirrors for slow networks. Unset means PyPI, Debian, npm and Hugging Face.
# PYPI_MIRROR=https://mirrors.aliyun.com/pypi/simple/
# APT_MIRROR=mirrors.aliyun.com
# NPM_REGISTRY=https://registry.npmmirror.com
# MODEL_HOST=https://www.modelscope.cn/models
# MODEL_REVISION=master
